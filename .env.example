# =============================================================================
# AI Website & Shorts Factory — environment template
# Copy to `.env` and fill in what you have. Everything has a safe default:
# missing credentials switch the affected stage into an explicit dry-run mode.
# Never commit the real `.env`.
# =============================================================================

# ---------------------------------------------------------------- runtime ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Public base URL of this app (used for OAuth redirects and local preview links).
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --------------------------------------------------------------- dashboard ---
# REQUIRED in production. Use a long random string: openssl rand -base64 32
DASHBOARD_PASSWORD=change-me-please
# Session signing secret: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12

# ------------------------------------------------------------- data layout ---
DATA_DIR=data
SITES_DIR=generated-sites
VIDEOS_DIR=generated-videos
RECORDINGS_DIR=recordings
LOGS_DIR=logs
CREDENTIALS_DIR=credentials
DATABASE_PATH=data/factory.sqlite

# --------------------------------------------------------------- OpenRouter --
# Get a key at https://openrouter.ai/keys (free models cost $0 but are rate limited).
OPENROUTER_API_KEY=
# Comma separated, ordered fallback list. Free models end with `:free`.
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free,qwen/qwen-2.5-72b-instruct:free
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_MAX_CALLS_PER_JOB=6
OPENROUTER_TEMPERATURE=0.8
SITE_REPAIR_ATTEMPTS=2
# AI responses are cached on disk (data/ai-cache) for 7 days by default.
AI_CACHE=true
AI_CACHE_TTL_HOURS=168
# Global safety valve: maximum AI calls per day across all jobs.
MAX_AI_CALLS_PER_DAY=40

# ------------------------------------------------------- Google / YouTube ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.readonly,https://www.googleapis.com/auth/youtube.upload
YOUTUBE_CHANNEL_ID=
# Polling: interval in minutes (scheduler) or an explicit cron expression.
POLL_SCHEDULE=interval
COMMENT_POLL_INTERVAL_MINUTES=20
COMMENT_POLL_CRON=*/20 * * * *
MAX_COMMENTS_PER_POLL=200
MAX_VIDEOS_PER_POLL=10
YOUTUBE_DAILY_QUOTA_UNITS=10000
MIN_COMMENT_LENGTH=12
MAX_COMMENT_LENGTH=2000
MAX_COMMENT_AGE_DAYS=90
MIN_COMMENT_LIKES=0
# Optional comma separated list of words that force a comment to be rejected.
COMMENT_BANNED_WORDS=

# -------------------------------------------------------------- publishing ---
# Public uploads are blocked unless this is true AND UPLOAD_PRIVACY=public.
ALLOW_PUBLIC_UPLOAD=false
UPLOAD_PRIVACY=private
# Refuse to upload videos whose recording/voice came from a dry-run artifact.
UPLOAD_REQUIRE_REAL_RECORDING=true

# ----------------------------------------------------------------- hosting ---
# local | github-pages | netlify
DEPLOY_PROVIDER=local
DEPLOY_VERIFY_TIMEOUT_MS=90000
DEPLOY_VERIFY_REQUIRED=true
LOCAL_SITE_PUBLIC_URL=http://localhost:3000/sites

# GitHub Pages (free for public repositories; ~1 GB site limit, 10 builds/hour)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_PREFIX=comment-site
GITHUB_REPO_VISIBILITY=public
GITHUB_PAGES_BRANCH=main
# Optional custom domain for Pages (leave empty for *.github.io)
GITHUB_PAGES_CNAME=

# Netlify (free tier: 100 GB bandwidth, 300 build minutes/month)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# --------------------------------------------------------------------- TTS ---
# piper | espeak | silent (silent is for dry-runs only)
TTS_ENGINE=piper
TTS_VOICE=en_US-amy-medium
TTS_LANGUAGE=en
TTS_SPEED=1.0
# Path to the Piper executable and voice model (.onnx). See scripts/install-piper.sh
PIPER_BIN=piper
PIPER_MODEL=
PIPER_CONFIG=
PIPER_LENGTH_SCALE=1.0
PIPER_SENTENCE_SILENCE=0.25
# espeak-ng fallback (lighter quality, zero setup on most Linux images)
ESPEAK_BIN=espeak-ng
ESPEAK_VOICE=en-us
ESPEAK_WPM=165
# Allow a silent placeholder track when no TTS engine exists (never uploaded).
TTS_ALLOW_SILENT_FALLBACK=true

# ------------------------------------------------------------------- video ---
FFMPEG_PATH=
FFPROBE_PATH=
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=21
VIDEO_PRESET=medium
VIDEO_AUDIO_BITRATE=192k
VIDEO_MIN_DURATION_SEC=8
VIDEO_MAX_DURATION_SEC=58
VIDEO_RENDER_TIMEOUT_MS=900000
FFMPEG_THREADS=2
BRAND_NAME=Built from a comment
# Optional royalty-free music file (looped quietly under narration).
BACKGROUND_MUSIC_PATH=
BACKGROUND_MUSIC_VOLUME=0.08

# --------------------------------------------------------------- recording ---
# Chromium is resolved automatically. Override only if needed.
CHROMIUM_EXECUTABLE_PATH=
CHROMIUM_CHANNEL=
RECORD_VIEWPORT_WIDTH=1080
RECORD_VIEWPORT_HEIGHT=1920
RECORD_SCROLL_STEP_PX=700
RECORD_MAX_SECTIONS=4
RECORD_SETTLE_MS=900
RECORD_CAPTURE_FPS=12
RECORD_MAX_DURATION_SEC=60
# Fall back to a screenshot animation if Chromium cannot launch.
ALLOW_SCREENSHOT_FALLBACK=true
# If no browser can run at all, finish the job with the website + script + narration and
# record "no video produced" instead of failing. Keep false on production hosts so a broken
# browser is loud; set true for API-only/CI hosts where video is impossible.
ALLOW_SKIP_VIDEO_WITHOUT_BROWSER=false
BROWSER_TIMEOUT_MS=60000

# ------------------------------------------------------------------ worker ---
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=60000
JOB_BACKOFF_MAX_MS=1800000
STAGE_TIMEOUT_MS=600000
DAILY_JOB_LIMIT=3
DAILY_UPLOAD_LIMIT=1
MAX_QUEUE_DEPTH=10
START_PAUSED=false

# ---------------------------------------------------------------- security ---
MAX_GENERATED_FILE_BYTES=524288
MAX_SITE_BYTES=3145728
MAX_SITE_FILES=40
MAX_COMMENT_BYTES=4000
BUILD_TIMEOUT_MS=120000
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_MS=300000

# -------------------------------------------------------------- dry run ------
# DRY_RUN=true forces every external integration into dry-run mode (safe demos).
DRY_RUN=false
