# =============================================================================
# WhatsApp Business Outreach Bot — environment template
#
# Copy to .env and fill in your own values:      cp .env.example .env
# NEVER commit .env. It is in .gitignore.
# Everything here is read by index.js → loadConfig(); unknown keys are ignored.
# =============================================================================

# ----------------------------------------------------------------------------
# WhatsApp / owner identity
# ----------------------------------------------------------------------------
# The WhatsApp number the bot runs on = YOUR number, digits only, with country
# code, no "+" and no spaces. India example: 919876543210
OWNER_NUMBER=

# Optional extra phones allowed to send owner commands (comma separated).
# Useful when the bot number is a business SIM and you command from your phone.
ADMIN_NUMBERS=

# Number that receives the pairing code. Defaults to OWNER_NUMBER.
PAIRING_NUMBER=

# Prefix for owner commands. Keep something you never type by accident.
COMMAND_PREFIX=!

# Where the WhatsApp session is stored.
#   database = in Supabase (recommended: Voroa has NO persistent disk)
#   file     = ./auth directory (fine on a laptop/VPS with a real disk)
AUTH_STATE=database
AUTH_DIR=./auth
AUTH_SESSION_ID=default
BAILEYS_LOG_LEVEL=error

# ----------------------------------------------------------------------------
# Business facts used by the AI (only these facts may be used)
# ----------------------------------------------------------------------------
BUSINESS_NAME=Your Studio
BUSINESS_DESCRIPTION=We design and build fast, mobile-friendly websites for small businesses.
# The exact first message sent by !pitch. Write it yourself; the AI never rewrites
# it unless you set ALLOW_AI_REWRITE_PITCH=true.
FIXED_PITCH=Hi! Thanks for your interest. We build simple, fast websites for small businesses — one page or five, mobile-first, live in a week. Would you like to see a sample?
DEMO_URL=https://demo.your-studio.example
ALLOW_AI_REWRITE_PITCH=false

# ----------------------------------------------------------------------------
# AI provider 1 — OpenRouter (free router)
# ----------------------------------------------------------------------------
# Create a key: https://openrouter.ai/keys  (no card needed for free models)
OPENROUTER_API_KEY=
# openrouter/free = OpenRouter's Free Models Router (released Feb 2026). It picks
# a random free model per request. Never put a paid model here.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_RETRIES=1
# Only enable if the routed model supports OpenAI-style JSON mode.
OPENROUTER_JSON_MODE=false
OPENROUTER_APP_URL=https://getvoroa.com
OPENROUTER_APP_NAME=WhatsApp Outreach Bot

# ----------------------------------------------------------------------------
# AI provider 2 — Google Gemini (fallback, free-tier Flash model only)
# ----------------------------------------------------------------------------
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-3.8-flash is on the documented free tier (checked 2026-10-24).
# Other documented free Flash models: gemini-3.6-flash, gemini-3.5-flash-lite,
# gemini-3.1-flash-lite. Run `npm run doctor` to see what YOUR key can use.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_RETRIES=1
# Refuse to call anything that is not on the documented free list unless you
# explicitly accept the cost. Never set this to a paid/Pro model by accident.
GEMINI_FORCE_MODEL=false

# ----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# ----------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string → URI
# Prefer the "Session pooler" / pooled URI on serverless platforms.
# Example shape (fake): postgresql://postgres.abcdefgh:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# require (default) | verify-full | disable
DATABASE_SSL=require

# ----------------------------------------------------------------------------
# Daily report (India time)
# ----------------------------------------------------------------------------
REPORT_TIME=21:00
REPORT_TIMEZONE=Asia/Kolkata
SCHEDULER_TICK_MS=30000
REPORT_RETRY_INTERVAL_MS=300000

# ----------------------------------------------------------------------------
# Safety rails
# ----------------------------------------------------------------------------
# Start with true. Nothing is sent; every intended message is logged and stored.
DRY_RUN=true
# Hard cap on messages the bot may send per local day (0 = no messages at all).
MAX_OUTBOUND_PER_DAY=20
# Minimum gap between two outgoing messages, in seconds.
MIN_SECONDS_BETWEEN_MESSAGES=20
# Max owner notifications (opt-out, review needed, AI failure) per hour.
MAX_OWNER_ALERTS_PER_HOUR=6
# Maximum reply length the AI may produce (characters).
MAX_MESSAGE_LENGTH=900

# AI content restrictions. Keep all of these false unless you really mean it.
ALLOW_PRICE_TALK=false
ALLOW_PROMISES=false
ALLOW_UNVERIFIED_ACTION_CLAIMS=false
ALLOW_DELIVERY_COMMITMENTS=false

# Behaviour toggles
SEND_OPTOUT_ACKNOWLEDGEMENT=false
AUTO_CLASSIFY_NEW_CONTACTS=false
NOTIFY_OWNER_ON_AI_FAILURE=true

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
LOG_LEVEL=info
# Optional HTTP health endpoint (0 = disabled). Voroa background workers are
# portless, so this is only useful if you deploy as a web service.
HEALTH_PORT=0
