# Copy to .env locally — NEVER commit the real .env
# Create a token at https://huggingface.co/settings/tokens (write scope for deploy)
HF_TOKEN=
# Optional: model to preload on startup (local only)
PRELOAD_MODEL=
# Force mock replies (no model download) — useful for testing the UI
MOCK_MODE=
DEVICE=auto
QUANTIZATION=auto
PORT=7860
HOST=0.0.0.0
